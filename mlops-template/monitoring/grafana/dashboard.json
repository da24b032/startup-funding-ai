{
  "title": "Churn Prediction MLOps Dashboard",
  "panels": [
    {
      "title": "Predictions per Second",
      "type": "graph",
      "targets": [{"expr": "rate(churn_predictions_total[1m])", "legendFormat": "{{predicted_class}}"}]
    },
    {
      "title": "Inference Latency (p95)",
      "type": "graph",
      "targets": [{"expr": "histogram_quantile(0.95, rate(churn_prediction_latency_seconds_bucket[5m]))", "legendFormat": "p95"}]
    },
    {
      "title": "Rolling Churn Rate",
      "type": "gauge",
      "targets": [{"expr": "churn_rate_rolling", "legendFormat": "Churn Rate"}]
    },
    {
      "title": "Feature Drift Scores",
      "type": "bargauge",
      "targets": [{"expr": "feature_drift_score", "legendFormat": "{{feature_name}}"}]
    }
  ]
}
